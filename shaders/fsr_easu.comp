#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#define A_GPU 1
#define A_GLSL 1
#define FSR_EASU_F 1

#include "ffx_a.h"
#include "ffx_fsr1.h"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inputImage;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outputImage;

layout(push_constant) uniform Push {
    uvec4 con0;
    uvec4 con1;
    uvec4 con2;
    uvec4 con3;
} pc;

// A captura X11 fornece cores sRGB em uma imagem UNORM. O FSR trabalha no
// espaço linear, e a swapchain sRGB faz a conversão inversa ao apresentar.
vec4 srgb_to_linear(vec4 color) {
    vec4 lo = color / 12.92;
    vec4 hi = pow((color + 0.055) / 1.055, vec4(2.4));
    return mix(lo, hi, step(vec4(0.04045), color));
}

AF4 FsrEasuRF(AF2 p) { return srgb_to_linear(textureGather(inputImage, p, 0)); }
AF4 FsrEasuGF(AF2 p) { return srgb_to_linear(textureGather(inputImage, p, 1)); }
AF4 FsrEasuBF(AF2 p) { return srgb_to_linear(textureGather(inputImage, p, 2)); }

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(gid, uvec2(imageSize(outputImage))))) return;
    vec3 pix;
    FsrEasuF(pix, gid, pc.con0, pc.con1, pc.con2, pc.con3);
    imageStore(outputImage, ivec2(gid), vec4(pix, 1.0));
}
